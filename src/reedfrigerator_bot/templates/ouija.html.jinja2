{% extends "base.html.jinja2" %}
{% block title %}Ouija{% endblock %}
{% block main %}
    <div class="align-items-center d-flex justify-content-center row" style="height: 100vh;">
    <div>

    <form action="/ouija" method="POST" class="col-12 input-group">
        <input name="message" type="text" class="form-control" readonly/>
            <button class="btn btn-outline-secondary" id="backspace" type="button" style="color: red">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-backspace" viewBox="0 0 16 16">
                    <path d="M5.83 5.146a.5.5 0 0 0 0 .708L7.975 8l-2.147 2.146a.5.5 0 0 0 .707.708l2.147-2.147 2.146 2.147a.5.5 0 0 0 .707-.708L9.39 8l2.146-2.146a.5.5 0 0 0-.707-.708L8.683 7.293 6.536 5.146a.5.5 0 0 0-.707 0z"/>
                    <path d="M13.683 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7.08a2 2 0 0 1-1.519-.698L.241 8.65a1 1 0 0 1 0-1.302L5.084 1.7A2 2 0 0 1 6.603 1zm-7.08 1a1 1 0 0 0-.76.35L1 8l4.844 5.65a1 1 0 0 0 .759.35h7.08a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"/>
                </svg>
            </button>
            <button id="submit" class="btn btn-primary" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
  <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z"/>
</svg>
            </button>
    </form>
    <div class="row justify-content-center">
        <div class="col-auto">
                    <emoji-picker class="light"></emoji-picker>
        </div>
    </div>
    <script>
    // JS Strings are not unicode native. SHAME
    function removeLastChar(str) {
        const segmenter = new Intl.Segmenter('en', { granularity: 'grapheme' });
        const segments = Array.from(segmenter.segment(str), s => s.segment);
        segments.pop();
        return segments.join('');
    }

    document.addEventListener("DOMContentLoaded", () => {
        const input = document.querySelector("input");

        input.addEventListener("keydown", ({key}) => {
            if (key === "Backspace" || key === "Delete") {
                input.value = removeLastChar(input.value)
            }
        })

        document.querySelector("#backspace").addEventListener("click", _ => {
            input.value = removeLastChar(input.value)
        })

        document.querySelector("emoji-picker").addEventListener("emoji-click", event => {
            input.value += event.detail.unicode
        })
    })
    </script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js"></script>
    </div>
    </div>
{% endblock %}

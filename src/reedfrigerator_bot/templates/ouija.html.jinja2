{% extends "base.html.jinja2" %}
{% block title %}Emojia{% endblock %}
{% block extrahead %}
    <script type="module">
    import {Picker} from "https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js";

    let message = [];

    const emojis = {{ emoji_json }};

    document.addEventListener("DOMContentLoaded", () => {
        const messageDiv = document.querySelector("#message");
        const backspaceBtn = document.querySelector("#backspace");
        const sendBtn = document.querySelector("#send");
        const alert = document.querySelector("#alert");
        let sendLock = false;

        const picker = new Picker({
            customEmoji: emojis
        });

        const backspace = () => {
            if (message.length > 0) {
                message.pop()
                messageDiv.removeChild(messageDiv.lastChild)
            }

            if (message.length === 0) {
                backspaceBtn.disabled = true;
                sendBtn.disabled = true;
            }
        }

        backspaceBtn.addEventListener("click", _ => backspace())

        document.querySelector("#picker-container").appendChild(picker)

        picker.addEventListener("emoji-click", event => {
            if (sendLock) {
                return;
            }

            if (event.detail.name) {
                message.push(event.detail.name);
                const img = document.createElement("img");
                img.src = event.detail.emoji.url;
                img.style = "height: 2.5rem";

                messageDiv.appendChild(img);
            } else {
                message.push(event.detail.unicode);
                const span = document.createElement("span");
                span.textContent = event.detail.unicode;
                messageDiv.appendChild(span);
            }

            backspaceBtn.disabled = false;
            sendBtn.disabled = false;
        });

        sendBtn.addEventListener("click", async _ => {
            if (sendLock) {
                return
            }
            sendLock = true;
            sendBtn.disabled = true;
            backspaceBtn.disabled = true;
            const resp = await fetch("/ouija/post", {
                method: "POST",
                body: JSON.stringify(message)
            })
            sendLock = false;
            sendBtn.disabled = false;
            backspaceBtn.disabled = false;
            alert.hidden = false;
            alert.textContent = await resp.text();
        }, false)
    })
    </script>
{% endblock %}
{% block main %}
    <div class="align-items-center d-flex justify-content-center" style="height: 100vh;">
        <div>
            <div id="alert" class="alert alert-primary" hidden></div>
            <div class="d-flex justify-content-center fs-1 align-items-center" id="message"></div>
            <br/>
            <div class="input-group justify-content-center">
                {# Backspace button #}
                <button class="btn btn-outline-secondary text-danger" id="backspace" type="button" aria-label="backspace" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-backspace" viewBox="0 0 16 16">
                        <path d="M5.83 5.146a.5.5 0 0 0 0 .708L7.975 8l-2.147 2.146a.5.5 0 0 0 .707.708l2.147-2.147 2.146 2.147a.5.5 0 0 0 .707-.708L9.39 8l2.146-2.146a.5.5 0 0 0-.707-.708L8.683 7.293 6.536 5.146a.5.5 0 0 0-.707 0z"/>
                        <path d="M13.683 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7.08a2 2 0 0 1-1.519-.698L.241 8.65a1 1 0 0 1 0-1.302L5.084 1.7A2 2 0 0 1 6.603 1zm-7.08 1a1 1 0 0 0-.76.35L1 8l4.844 5.65a1 1 0 0 0 .759.35h7.08a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"/>
                    </svg>
                </button>
                {# Send button #}
                <button id="send" class="btn btn-primary" type="submit" aria-label="Send" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z"/>
                    </svg>
                </button>
            </div>
            <div class="row justify-content-center">
                <div class="col-auto" id="picker-container">
                </div>
            </div>
        </div>
    </div>
{% endblock %}
